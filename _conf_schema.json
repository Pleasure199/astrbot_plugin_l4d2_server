{
  "servers": {
    "description": "L4D2 服务器列表",
    "hint": "点击「添加」创建服务器配置，支持多台服务器同时管理",
    "type": "template_list",
    "default": [],
    "templates": {
      "l4d2_server": {
        "name": "L4D2 专用服务器",
        "hint": "配置一台 L4D2 专用服务器的连接与启动参数",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "服务器标识名",
            "hint": "用于指令中指定服务器，如 /l4d2 start 服务器名",
            "default": ""
          },
          "host": {
            "type": "string",
            "description": "服务器 IP",
            "hint": "RCON 连接地址，本机填 127.0.0.1",
            "default": "127.0.0.1"
          },
          "port": {
            "type": "int",
            "description": "游戏端口",
            "default": 27015
          },
          "rcon_port": {
            "type": "int",
            "description": "RCON 端口",
            "hint": "通常与游戏端口相同",
            "default": 27015
          },
          "rcon_password": {
            "type": "string",
            "description": "RCON 密码",
            "hint": "需与服务器 server.cfg 中的 rcon_password 一致",
            "default": "",
            "secret": true
          },
          "srcds_path": {
            "type": "string",
            "description": "服务器目录或 srcds 路径",
            "hint": "可填服务器目录（自动查找 start.sh）或 srcds 可执行文件完整路径",
            "default": ""
          },
          "start_params": {
            "type": "string",
            "description": "额外启动参数",
            "hint": "如 -tickrate 100 +mp_gamemode versus，可留空",
            "default": ""
          },
          "max_players": {
            "type": "int",
            "description": "最大玩家数",
            "default": 8
          },
          "default_map": {
            "type": "string",
            "description": "启动默认地图",
            "default": "c2m1_highway"
          },
          "ssh_enabled": {
            "type": "bool",
            "description": "启用 SSH 远程管理",
            "hint": "AstrBot 与服务器不在同一台机器时开启，通过 SSH 执行启停命令",
            "default": false
          },
          "ssh_host": {
            "type": "string",
            "description": "SSH 主机地址",
            "hint": "远程服务器的 IP 或域名",
            "default": ""
          },
          "ssh_port": {
            "type": "int",
            "description": "SSH 端口",
            "default": 22
          },
          "ssh_username": {
            "type": "string",
            "description": "SSH 用户名",
            "default": ""
          },
          "ssh_password": {
            "type": "string",
            "description": "SSH 密码",
            "hint": "密码认证时填写；使用密钥认证时可作为密钥口令",
            "default": "",
            "secret": true
          },
          "ssh_key_path": {
            "type": "string",
            "description": "SSH 私钥路径",
            "hint": "可选，使用密钥认证时填写私钥文件的本地路径",
            "default": ""
          },
          "rcon_via_ssh": {
            "type": "bool",
            "description": "RCON 经 SSH 通道连接",
            "hint": "默认开启：RCON 指令会通过 SSH 通道转发到远程主机的 127.0.0.1:rcon_port，无需对外暴露 RCON 端口；只有在 AstrBot 能直连 RCON 端口、或远程主机禁止 SSH 端口转发时才需要关闭",
            "default": true
          },
          "rcon_tunnel_host": {
            "type": "string",
            "description": "RCON 隧道目标地址",
            "hint": "留空表示远程主机本机（127.0.0.1）；服务端运行在 Docker 等容器里时可填容器 IP（如 172.17.0.2），端口仍取 rcon_port",
            "default": ""
          }
        }
      }
    }
  },
  "admins": {
    "description": "管理员 QQ 号",
    "hint": "列表中的用户可执行启停、踢人、切图等管理操作",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    }
  },
  "allow_public_query": {
    "description": "允许公开查询",
    "hint": "开启后所有人可使用 list / status / players；关闭后仅管理员可查询",
    "type": "bool",
    "default": true
  }
}
